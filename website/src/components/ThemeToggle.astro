<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="切换到浅色主题"
  title="切换到浅色主题"
>
  <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
  </svg>
  <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.2 15.3A8.5 8.5 0 0 1 8.7 3.8 8.5 8.5 0 1 0 20.2 15.3Z"></path>
  </svg>
  <span class="sr-only">切换主题</span>
</button>

<script>
  const storageKey = 'arcadia-theme';
  const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');

  const syncToggle = () => {
    if (!toggle) return;
    const isDark = document.documentElement.dataset.theme === 'dark';
    const nextTheme = isDark ? '浅色' : '深色';
    toggle.setAttribute('aria-label', `切换到${nextTheme}主题`);
    toggle.setAttribute('title', `切换到${nextTheme}主题`);
    toggle.setAttribute('aria-pressed', String(!isDark));
  };

  syncToggle();
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem(storageKey, next);
    syncToggle();
  });
</script>
