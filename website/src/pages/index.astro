---
import BaseLayout from '../layouts/BaseLayout.astro';
import { capabilities } from '../data/site';
import { getCollection } from 'astro:content';
const products = await getCollection('products', ({data}) => data.featured);
---
<BaseLayout>
  <section class="relative overflow-hidden border-b border-[var(--line)]">
    <div class="absolute inset-0 grid-lines opacity-25 [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
    <div class="shell relative grid min-h-[calc(100vh-72px)] items-center gap-14 py-20 lg:grid-cols-[1.15fr_.85fr]">
      <div><p class="eyebrow">Local-first AI knowledge browser</p><h1 class="display mt-8">浏览，<br/>然后留下<span class="text-[var(--acid)]">知识。</span></h1><p class="muted mt-8 max-w-xl text-lg">Arcadia 把阅读、理解、保存、检索和研究连接在一起。你的资料留在本地，你的思考继续向前。</p><div class="mt-9 flex flex-wrap gap-3"><a href="/download/" class="btn btn-primary">获取开发预览</a><a href="/products/arcadia/" class="btn">了解产品</a></div></div>
      <div class="relative mx-auto w-full max-w-[520px] border border-[var(--line)] bg-[var(--panel)] p-3 shadow-2xl shadow-black/40">
        <div class="mb-3 flex items-center gap-2 border-b border-[var(--line)] px-2 pb-3"><span class="size-2 rounded-full bg-[#ff6b62]"></span><span class="size-2 rounded-full bg-[#ffc952]"></span><span class="size-2 rounded-full bg-[var(--acid)]"></span><span class="ml-3 flex-1 bg-[#111511] px-3 py-1 text-xs muted">research.local / reading</span></div>
        <div class="grid min-h-[410px] grid-cols-[72px_1fr]"><div class="border-r border-[var(--line)] pt-4 text-center text-xs muted"><div class="mx-auto mb-6 flex size-9 items-center justify-center bg-[var(--acid)] font-bold text-[#10130f]">A</div><div class="space-y-5"><div>◫</div><div>⌕</div><div>◇</div><div>✦</div></div></div><div class="p-6"><p class="text-xs text-[var(--acid)]">READER MODE</p><h2 class="mt-4 text-3xl font-semibold leading-tight tracking-tight">把网页变成可以继续使用的知识</h2><div class="mt-7 space-y-3"><div class="h-2 w-full bg-[#343a34]"></div><div class="h-2 w-11/12 bg-[#343a34]"></div><div class="h-2 w-4/5 bg-[#343a34]"></div></div><div class="mt-8 border-l-2 border-[var(--acid)] bg-[#111511] p-4"><p class="text-xs muted">AI 摘要</p><p class="mt-2 text-sm">文章讨论了本地优先软件如何在不牺牲隐私的前提下，提供更连续的知识工作流。</p></div><div class="mt-6 flex gap-2"><span class="border border-[var(--line)] px-3 py-1 text-xs">保存到知识库</span><span class="border border-[var(--line)] px-3 py-1 text-xs">继续提问</span></div></div></div>
      </div>
    </div>
  </section>
  <section class="shell py-28"><div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr]"><div><p class="eyebrow">One continuous loop</p><h2 class="section-title mt-6">不再从<br/>零开始。</h2></div><div class="grid sm:grid-cols-2">{capabilities.map((item,i)=><article class:list={["min-h-64 border-[var(--line)] p-7", i%2===0?"sm:border-r":"", i<2?"border-b":""]}><span class="text-sm text-[var(--acid)]">{item.no}</span><h3 class="mt-12 text-2xl font-semibold">{item.title}</h3><p class="muted mt-3">{item.body}</p></article>)}</div></div></section>
  <section class="border-y border-[var(--line)] bg-[var(--acid)] py-20 text-[#11150f]"><div class="shell grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end"><div><p class="text-sm font-bold uppercase tracking-[.16em]">Built around your data</p><h2 class="mt-4 max-w-4xl text-4xl font-semibold leading-[1.05] tracking-[-.04em] md:text-7xl">工具可以更聪明，<br/>数据不必离开你。</h2></div><a href="/privacy/" class="btn border-[#11150f]">我们的隐私原则</a></div></section>
  <section class="shell py-28"><div class="flex flex-wrap items-end justify-between gap-6"><div><p class="eyebrow">Product</p><h2 class="section-title mt-6">正在构建</h2></div><a href="/products/" class="text-sm text-[var(--acid)]">查看产品中心</a></div>{products.map(p=><a href={`/products/${p.id}/`} class="mt-12 grid gap-10 border border-[var(--line)] bg-[var(--panel)] p-8 transition hover:border-[var(--acid)] md:grid-cols-[1fr_auto] md:items-end"><div><span class="text-xs uppercase tracking-[.16em] muted">{p.data.category} · v{p.data.version}</span><h3 class="mt-3 text-5xl font-semibold tracking-[-.04em]">{p.data.title}</h3><p class="muted mt-4 max-w-xl text-lg">{p.data.description}</p></div><span class="btn btn-primary">查看详情</span></a>)}</section>
</BaseLayout>
